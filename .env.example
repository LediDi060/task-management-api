# Настройки для локального Docker Compose.
# При смене POSTGRES_PASSWORD также обновите DATABASE_URL.
POSTGRES_PASSWORD=tasks
DATABASE_URL=postgresql+asyncpg://tasks:tasks@db:5432/tasks

# Пустое значение создаёт случайный ключ при запуске API.
# Для токенов, переживающих перезапуск, задайте результат:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
JWT_EXPIRE_MINUTES=30

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=tasks@example.com
